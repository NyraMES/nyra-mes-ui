# Nyra Video Demo UI — copy to .env.demo and run: npm run dev:demo
# Uses fictional NYRA_VIDEO_DEMO tenant only. Safe for prospect videos.

VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_AUTH_ENABLED=false

# Demo hardening — hides ontology/KG, shows watermark, view-only UX
VITE_DEMO_MODE=true
VITE_DEMO_READ_ONLY=true

# Optional — API also defaults to this tenant when started with .env.demo
VITE_TENANT_CODE=NYRA_VIDEO_DEMO

# Cognito (only when hosting demo with AUTH_ENABLED=true on API + UI)
# VITE_AUTH_ENABLED=true
# VITE_COGNITO_REGION=eu-north-1
# VITE_COGNITO_USER_POOL_ID=
# VITE_COGNITO_CLIENT_ID=
# VITE_COGNITO_REDIRECT_SIGN_IN=http://localhost:5173/login
# VITE_COGNITO_REDIRECT_SIGN_OUT=http://localhost:5173/
