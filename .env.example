# API
VITE_API_BASE_URL=http://127.0.0.1:8000

# Set true when Cognito is configured (must match API AUTH_ENABLED)
VITE_AUTH_ENABLED=false

# AWS Cognito (SPA app client)
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=

# Optional Hosted UI / SSO
VITE_COGNITO_DOMAIN=
VITE_COGNITO_REDIRECT_SIGN_IN=http://localhost:5173/login
VITE_COGNITO_REDIRECT_SIGN_OUT=http://localhost:5173/
