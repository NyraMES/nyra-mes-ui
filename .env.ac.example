# =============================================================================
# Activated Carbon local validation — copy to .env.ac and use with npm run dev:ac
# Full read/write (not the video demo workspace)
# =============================================================================

VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_AUTH_ENABLED=false
VITE_DEMO_MODE=false
VITE_DEMO_READ_ONLY=false

# Client tenant — omit to use the generic Activated Carbon demo (SAM_CARBONS_DEMO).
# Example for a specific client deployment:
# VITE_TENANT_CODE=SAM_CARBONS
# VITE_WORKSPACE_CODE=SAM_CARBONS_ACTIVATED_CARBON

# Optional: industry-only host (tenant from env above or demo default)
# VITE_HOST_TENANT_MAP=ac.localhost=activated-carbon
# Client domain example:
# VITE_HOST_TENANT_MAP=ac.client.com=CLIENT_TENANT_CODE:CLIENT_WORKSPACE:activated-carbon

# Modbus simulator API (dashboard telemetry panel)
VITE_MODBUS_SIM_API_URL=http://127.0.0.1:8010
VITE_MODBUS_SIM_DEVICE_CODE=KILN_01_MODBUS_SIM

# When testing Cognito locally for a client tenant:
# VITE_AUTH_ENABLED=true
# VITE_COGNITO_REGION=us-east-1
# VITE_COGNITO_USER_POOL_ID=
# VITE_COGNITO_CLIENT_ID=
